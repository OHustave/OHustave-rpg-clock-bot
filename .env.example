# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=coloque_seu_token_aqui

# Application ID (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=coloque_o_application_id_aqui

# (Opcional) ID do servidor para registrar os comandos instantaneamente durante os testes.
# Se deixar vazio, os comandos sao registrados globalmente (pode levar ate 1h para aparecer).
GUILD_ID=

# (Opcional) Caminho do arquivo onde os dados sao salvos. Padrao: ./data/guilds.json
DATA_FILE=
